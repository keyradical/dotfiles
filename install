#!/usr/bin/env bash
#
# Bootstrap script: applies the shared dotbot config, plus an optional
# host overlay.
#
# Default (no arg) = lean install: shared configs only. Good for remote
# SSH boxes — just nvim/tmux/zsh/git/kitty/claude/starship, no Aerospace
# or Sway overlay.
#
# Beyond linking, this script installs the userspace runtime deps that the
# linked configs require unconditionally: dotbot, starship (zshrc evals it),
# the zsh plugins (zshrc sources them), and TPM + tmux plugins. All of these
# are sudo-free and distro-agnostic.
#
# It does NOT install OS packages (zsh, tmux, nvim, a compiler). Those need a
# package manager and sudo — see fedora-install.sh or ubuntu-install.sh.
#
# Host overlays:
#   mac     — adds Aerospace
#   pc      — adds Sway + waybar + PC bindings
#   laptop  — adds Sway + waybar + laptop bindings (autorotate via local)
#
# Host selection precedence:
#   1. CLI arg:           ./install mac
#   2. $DOTFILES_HOST:    DOTFILES_HOST=laptop ./install
#   3. ~/.dotfiles-host file (written by previous run)
#   4. (none — lean install)

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST_FILE="${HOME}/.dotfiles-host"
ZSH_PLUGINS_DIR="${HOME}/.local/share/zsh/plugins"

info()  { printf '\r[ .. ] %s\n' "$*"; }
ok()    { printf '\r[ OK ] %s\n' "$*"; }
warn()  { printf '\r[WARN] %s\n' "$*" >&2; }
die()   { printf '\r[FAIL] %s\n' "$*" >&2; exit 1; }

command_exists() { command -v "$1" >/dev/null 2>&1; }

# pipx, `pip install --user`, and the starship installer all drop binaries into
# ~/.local/bin. config/zsh/zshenv puts that on PATH, but this script runs under
# bash, where it is usually absent (Ubuntu only adds it from ~/.profile, and
# only for login shells). Prepend it so tools installed below are visible to the
# command_exists checks that follow.
export PATH="${HOME}/.local/bin:${PATH}"

# Distro-appropriate install hint, used in dependency error messages.
pkg_hint() {
    local pkg="$1"
    if command_exists apt-get; then
        echo "sudo apt install -y $pkg"
    elif command_exists dnf; then
        echo "sudo dnf install -y $pkg"
    elif command_exists brew; then
        echo "brew install $pkg"
    else
        echo "install $pkg with your package manager"
    fi
}

# ── Resolve host ────────────────────────────────────────────────────────────

resolve_host() {
    if [[ $# -ge 1 ]]; then
        echo "$1"
        return
    fi
    if [[ -n "${DOTFILES_HOST:-}" ]]; then
        echo "$DOTFILES_HOST"
        return
    fi
    if [[ -f "$HOST_FILE" ]]; then
        cat "$HOST_FILE"
        return
    fi
    echo ""
}

HOST="$(resolve_host "$@")"

case "$HOST" in
    ""|mac|pc|laptop) ;;
    *) die "Unknown host '$HOST'. Use one of: mac, pc, laptop (or no arg for lean install)." ;;
esac

if [[ -n "$HOST" ]]; then
    echo "$HOST" > "$HOST_FILE"
    ok "Host = $HOST"
else
    ok "Host = (none, lean install — pass mac/pc/laptop for host extras)"
fi

# ── Install dotbot ──────────────────────────────────────────────────────────

install_dotbot() {
    if command_exists dotbot; then
        return
    fi
    info "Installing dotbot..."
    if [[ "$(uname)" == "Darwin" ]] && command_exists brew; then
        brew install dotbot
    elif command_exists pipx; then
        pipx install dotbot
    elif command_exists python3; then
        # Debian 12 / Ubuntu 24.04+ mark the system Python as externally
        # managed (PEP 668), which makes `pip install --user` a hard error.
        # Retry with the override before giving up, since there is no venv
        # to fall back to at this point in the bootstrap.
        python3 -m pip install --user dotbot \
            || python3 -m pip install --user --break-system-packages dotbot \
            || die "pip could not install dotbot. Install pipx first: $(pkg_hint pipx)"
    else
        die "dotbot needs brew, pipx or pip. On a fresh box run $(bootstrap_hint) instead."
    fi
    command_exists dotbot || die "dotbot installed but not on PATH. Add ~/.local/bin to PATH and re-run."
    ok "dotbot installed"
}

# Fresh-box entry point hint for the dependency failures above.
bootstrap_hint() {
    if command_exists apt-get; then
        echo "./ubuntu-install.sh"
    elif command_exists dnf; then
        echo "./fedora-install.sh"
    else
        echo "your distro bootstrap script"
    fi
}

# clean_link_conflicts (below) parses the dotbot YAML with PyYAML. The system
# python3 frequently lacks it — homebrew's python3 on macOS does — and because
# that python3 call is the last command in the function with its stderr
# discarded, a missing PyYAML used to abort this whole script under `set -e`
# with no output at all and exit 1.
#
# dotbot itself cannot run without PyYAML, so whichever interpreter dotbot was
# installed against is guaranteed to have it. Prefer that one, then fall back to
# python3. The import test is the real gate, so a shebang we cannot parse just
# falls through harmlessly.
PYTHON_BIN=""
resolve_python() {
    local candidates=() dotbot_bin shebang interp py

    dotbot_bin="$(command -v dotbot || true)"
    if [[ -n "$dotbot_bin" && -f "$dotbot_bin" ]]; then
        shebang="$(head -1 "$dotbot_bin")"
        if [[ "$shebang" == '#!'* ]]; then
            interp="${shebang#\#!}"
            # Handle `#!/usr/bin/env python3` as well as an absolute path.
            [[ "$interp" == */env\ * ]] && interp="${interp##*env }"
            [[ "$interp" == *python* ]] && candidates+=("$interp")
        fi
    fi
    candidates+=(python3)

    for py in "${candidates[@]}"; do
        if command_exists "$py" && "$py" -c 'import yaml' >/dev/null 2>&1; then
            PYTHON_BIN="$py"
            return 0
        fi
    done

    warn "No python interpreter with PyYAML found (needed to clear conflicting files)."
    if [[ "$(uname)" == "Darwin" ]]; then
        die "Install it with: pip3 install --user pyyaml"
    fi
    warn "Install it with: $(pkg_hint python3-yaml)"
    die "Or on a fresh box run $(bootstrap_hint), which installs it."
}

install_dotbot
resolve_python
ok "Using $PYTHON_BIN for link-conflict cleanup"

# ── Run dotbot with the right combination of YAMLs ─────────────────────────

# Dotbot refuses to replace an existing real file/dir with a symlink when
# force: false (our default). This helper scans the YAML for link targets and
# removes any that are real files/dirs (not symlinks) so dotbot can proceed.
clean_link_conflicts() {
    local conf="$1"
    "$PYTHON_BIN" - "$conf" "$BASEDIR" <<'PY'
import os, sys, yaml, shutil

conf = sys.argv[1]
BASEDIR = os.path.abspath(sys.argv[2])
if not os.path.isfile(conf):
    sys.exit(0)

with open(conf) as f:
    data = yaml.safe_load(f) or []

for item in data:
    if not isinstance(item, dict):
        continue
    links = item.get("link")
    if not links:
        continue
    # dotbot link: can be a flat dict or a list of dicts
    targets = []
    if isinstance(links, dict):
        targets = list(links.keys())
    elif isinstance(links, list):
        for entry in links:
            if isinstance(entry, dict):
                targets.extend(entry.keys())

    for target in targets:
        target = os.path.expanduser(target)

        # If the target itself is a symlink, dotbot will relink it — skip.
        if os.path.islink(target):
            continue

        # If a parent directory is a symlink to the repo, the user has an
        # old whole-dir symlink (e.g. ~/.config/sway -> repo/config/sway).
        # Removing a file *inside* it would delete the repo file. Break the
        # parent symlink first by removing it.
        parent = os.path.dirname(target)
        while parent and parent != os.path.expanduser("~") and parent != "/":
            if os.path.islink(parent):
                real = os.path.realpath(parent)
                if real.startswith(BASEDIR):
                    print(f"[dotfiles] Breaking legacy symlink: {parent} -> {real}")
                    os.remove(parent)
                    break
            parent = os.path.dirname(parent)

        if os.path.exists(target):
            print(f"[dotfiles] Removing conflicting real file/dir: {target}")
            if os.path.isdir(target):
                shutil.rmtree(target)
            else:
                os.remove(target)
PY
}

run_dotbot() {
    local conf="$1"
    clean_link_conflicts "$conf"
    info "Applying $conf"
    dotbot -d "$BASEDIR" -c "$conf"
}

# Legacy Mac layout migration.
# Older Mac dotfiles linked the entire ~/.config as one symlink into the repo,
# which meant app-managed dirs (gh, github-copilot, fish, opencode, bk.yaml,
# htop) ended up physically in the repo. This setup uses per-subdir symlinks
# instead, so ~/.config must be a real directory.
#
# This function is idempotent: it parks any untracked entries in repo/config/
# into ~/.config-migration/ once, drops the legacy symlink, and at the end
# moves the parked entries back into the new real ~/.config. If interrupted
# part-way, re-running just resumes from wherever it stopped.
MIGRATION_DIR="${HOME}/.config-migration"

park_untracked_config() {
    if [[ "$HOST" != "mac" ]]; then return; fi
    if [[ ! -L "$HOME/.config" ]]; then return; fi
    local target
    target="$(readlink "$HOME/.config")"
    case "$target" in
        "$BASEDIR/config"|*"/.dotfiles/config") ;;
        *) return ;;
    esac

    info "Legacy ~/.config symlink detected — migrating to per-subdir layout"
    mkdir -p "$MIGRATION_DIR"

    # Build a newline-separated, deduped list of candidate top-level entries
    # under repo/config/ to preserve. Tracked entries (nvim, tmux, zsh, etc.)
    # stay put — dotbot will symlink them into the new ~/.config. Anything
    # else is app data that lives in the repo only because of the legacy
    # whole-dir symlink, and needs to be parked.
    local candidates
    candidates=$(
        {
            if command -v git >/dev/null 2>&1 && [[ -d "$BASEDIR/.git" ]]; then
                # --exclude-standard skips gitignored files like
                # config/nvim/lazy-lock.json — without it, we'd extract
                # "nvim" and incorrectly park the whole nvim dir.
                ( cd "$BASEDIR" && \
                  git ls-files --others --exclude-standard \
                      --directory --no-empty-directory config/ ) \
                  | awk -F/ '$1=="config" && $2!="" { print $2 }'
            fi
            printf 'bk.yaml\nfish\ngh\ngithub-copilot\nhtop\nopencode\n'
        } | sort -u
    )

    local count=0
    local name src dst
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        src="$target/$name"          # resolves through the legacy symlink
        dst="$MIGRATION_DIR/$name"
        if [[ ! -e "$src" && ! -L "$src" ]]; then continue; fi
        if [[ -e "$dst" || -L "$dst" ]]; then
            warn "Already parked: $dst (skipping)"
            continue
        fi
        mv "$src" "$dst"
        count=$((count+1))
    done <<< "$candidates"

    if [[ $count -eq 1 ]]; then
        ok "Parked $count entry -> $MIGRATION_DIR"
    else
        ok "Parked $count entries -> $MIGRATION_DIR"
    fi

    rm "$HOME/.config"
    ok "Removed legacy ~/.config symlink"
}

restore_parked_config() {
    if [[ ! -d "$MIGRATION_DIR" ]]; then return; fi
    info "Restoring parked entries into ~/.config"
    local moved=0 skipped=0
    shopt -s nullglob dotglob
    for entry in "$MIGRATION_DIR"/*; do
        local name; name="$(basename "$entry")"
        local dst="$HOME/.config/$name"
        if [[ -e "$dst" || -L "$dst" ]]; then
            warn "  ~/.config/$name already exists; leaving $entry in $MIGRATION_DIR"
            skipped=$((skipped+1))
            continue
        fi
        mv "$entry" "$dst"
        moved=$((moved+1))
    done
    shopt -u nullglob dotglob
    rmdir "$MIGRATION_DIR" 2>/dev/null && ok "Restore complete ($moved moved)" || \
        warn "$skipped item(s) left in $MIGRATION_DIR — review and merge manually"
}

park_untracked_config

run_dotbot "$BASEDIR/install.conf.yaml"

case "$HOST" in
    mac)
        run_dotbot "$BASEDIR/hosts/mac/install.conf.yaml"
        ;;
    pc)
        run_dotbot "$BASEDIR/hosts/_linux.conf.yaml"
        run_dotbot "$BASEDIR/hosts/pc/install.conf.yaml"
        ;;
    laptop)
        run_dotbot "$BASEDIR/hosts/_linux.conf.yaml"
        run_dotbot "$BASEDIR/hosts/laptop/install.conf.yaml"
        ;;
esac

# Restore any app data that the legacy-layout migration parked aside.
restore_parked_config

# ── Claude Code settings (base + per-host overlay) ──────────────────────────

# ~/.claude/settings.json is generated, not symlinked. Claude Code has no
# user-level settings.local.json to merge from, so a base + overlay split has to
# be resolved here.
#
# Overlay is chosen by host class: config/claude/settings.<host>.json, with
# "remote" used for lean installs (no ~/.dotfiles-host). Coder workspace
# hostnames change on every rebuild, so keying on hostname would go stale.
# config/claude/settings.local.json, if present, is applied last and is
# gitignored — for one-off tweaks on a single box.
#
# In an overlay, a null value DELETES that key from the base, and keys starting
# with "//" are treated as comments and dropped. That way the base stays the
# full desktop config and only the remote overlay subtracts from it.
CLAUDE_SETTINGS_OUT="${HOME}/.claude/settings.json"
CLAUDE_OVERLAY="$BASEDIR/config/claude/settings.${HOST:-remote}.json"

info "Generating $CLAUDE_SETTINGS_OUT (host=${HOST:-remote})"
mkdir -p "${HOME}/.claude"

# Earlier versions symlinked this file into the repo. Leaving the symlink would
# make the write below edit the tracked file instead of generating a real one.
if [[ -L "$CLAUDE_SETTINGS_OUT" ]]; then
    info "Removing legacy settings.json symlink"
    rm "$CLAUDE_SETTINGS_OUT"
fi

"$PYTHON_BIN" - "$BASEDIR/config/claude/settings.json" "$CLAUDE_OVERLAY" \
               "$BASEDIR/config/claude/settings.local.json" "$CLAUDE_SETTINGS_OUT" <<'PY'
import json, os, sys, shutil

base_path, overlay_path, local_path, out_path = sys.argv[1:5]

def load(p):
    if not os.path.isfile(p):
        return None
    with open(p) as f:
        return json.load(f)

def merge(base, over):
    for k, v in over.items():
        if k.startswith("//"):
            continue
        if v is None:
            base.pop(k, None)
        elif isinstance(v, dict) and isinstance(base.get(k), dict):
            merge(base[k], v)
        else:
            base[k] = v
    return base

result = load(base_path)
if result is None:
    sys.exit(f"missing base config: {base_path}")

applied = []
for p in (overlay_path, local_path):
    over = load(p)
    if over is not None:
        merge(result, over)
        applied.append(os.path.basename(p))

rendered = json.dumps(result, indent=2) + "\n"

# Never clobber unabsorbed /config edits silently: those are made in the Claude
# Code UI and would otherwise vanish with no trace.
if os.path.isfile(out_path):
    with open(out_path) as f:
        current = f.read()
    if current != rendered:
        shutil.copy2(out_path, out_path + ".bak")
        print(f"[dotfiles] settings.json differed; previous saved to {out_path}.bak")

with open(out_path, "w") as f:
    f.write(rendered)

print("[dotfiles] overlays applied: " + (", ".join(applied) if applied else "none"))
PY
ok "Claude settings generated"

# ── Starship ────────────────────────────────────────────────────────────────

# zshrc runs `eval "$(starship init zsh)"` with no guard, so linking zshrc
# without starship present means an error on every prompt. Install it here
# rather than leaving it to the per-distro bootstrap scripts.
#
# No sudo: the official script drops a static binary into ~/.local/bin, which
# zshenv already puts on PATH. A distro bootstrap that prefers its own package
# (e.g. `dnf install starship`) can run before this and the check short-circuits.
if command_exists starship; then
    ok "starship already installed"
elif [[ "$(uname)" == "Darwin" ]] && command_exists brew; then
    info "Installing starship via brew..."
    brew install starship
    ok "starship installed"
else
    info "Installing starship to ~/.local/bin..."
    mkdir -p "${HOME}/.local/bin"
    if curl -sS https://starship.rs/install.sh | sh -s -- -y -b "${HOME}/.local/bin"; then
        ok "starship installed to ~/.local/bin"
    else
        warn "starship install failed — your prompt will error until it is installed"
    fi
fi

# ── Claude Code ─────────────────────────────────────────────────────────────

# install.conf.yaml links ~/.claude/settings.json and ~/.claude/hooks, so the
# binary they configure belongs to this setup too.
#
# The native installer is sudo-free, needs no node, and drops a self-updating
# launcher at ~/.local/bin/claude — already on PATH via zshenv. On macOS prefer
# the brew cask so the rest of the mac toolchain keeps managing it (note that
# brew installs do not auto-update; `brew upgrade` is on you).
if command_exists claude; then
    ok "claude already installed ($(claude --version 2>/dev/null || echo 'version unknown'))"
elif [[ "$(uname)" == "Darwin" ]] && command_exists brew; then
    info "Installing Claude Code via brew..."
    if brew install --cask claude-code@latest; then
        ok "claude installed"
    else
        warn "claude install failed — retry: brew install --cask claude-code@latest"
    fi
else
    info "Installing Claude Code to ~/.local/bin..."
    if curl -fsSL https://claude.ai/install.sh | bash; then
        ok "claude installed"
    else
        warn "claude install failed — see https://code.claude.com/docs/en/setup"
    fi
fi

# ── Zsh plugins ─────────────────────────────────────────────────────────────

# zshrc's source-plugin() looks these up in ~/.local/share/zsh/plugins and
# prints "zsh plugin not found: <name>" once per plugin per shell start when
# they are absent. Keep this list in sync with the source-plugin calls in
# config/zsh/zshrc.
ZSH_PLUGINS=(
    "zsh-autosuggestions|https://github.com/zsh-users/zsh-autosuggestions"
    "zsh-history-substring-search|https://github.com/zsh-users/zsh-history-substring-search"
    "zsh-syntax-highlighting|https://github.com/zsh-users/zsh-syntax-highlighting"
    "zsh-completions|https://github.com/zsh-users/zsh-completions"
)

info "Installing zsh plugins..."
mkdir -p "$ZSH_PLUGINS_DIR"
for entry in "${ZSH_PLUGINS[@]}"; do
    plugin_name="${entry%%|*}"
    plugin_url="${entry##*|}"
    plugin_dest="$ZSH_PLUGINS_DIR/$plugin_name"

    if [[ -d "$plugin_dest/.git" ]]; then
        git -C "$plugin_dest" pull --ff-only --quiet \
            || warn "Could not update $plugin_name (keeping existing checkout)"
    else
        rm -rf "$plugin_dest"
        git clone --depth=1 --quiet "$plugin_url" "$plugin_dest" \
            || warn "Could not clone $plugin_name"
    fi
done
ok "zsh plugins ready"

# ── TPM (tmux plugin manager) ───────────────────────────────────────────────

TPM_DIR="${HOME}/.config/tmux/plugins/tpm"
if [[ -x "$TPM_DIR/tpm" ]]; then
    :  # TPM main script present and executable
elif [[ -d "$TPM_DIR/.git" ]]; then
    :  # already installed via git clone
elif [[ -d "$TPM_DIR" ]]; then
    info "TPM directory exists but main script missing — cloning..."
    rm -rf "$TPM_DIR"
    mkdir -p "$(dirname "$TPM_DIR")"
    git clone --depth=1 https://github.com/tmux-plugins/tpm "$TPM_DIR"
    ok "TPM installed"
else
    info "Installing TPM (tmux plugin manager)..."
    mkdir -p "$(dirname "$TPM_DIR")"
    git clone --depth=1 https://github.com/tmux-plugins/tpm "$TPM_DIR"
    ok "TPM installed"
fi

# Install plugins declared in tmux.conf + remove ones no longer declared.
# TPM ships these scripts that work headlessly (no prefix+I needed).
if [[ -x "$TPM_DIR/bin/install_plugins" ]]; then
    info "Installing tmux plugins via TPM..."
    "$TPM_DIR/bin/install_plugins" >/dev/null 2>&1 \
        && ok "tmux plugins installed" \
        || warn "TPM install_plugins exited non-zero (will be retried on next run)"
fi
if [[ -x "$TPM_DIR/bin/clean_plugins" ]]; then
    info "Cleaning tmux plugins no longer in tmux.conf..."
    "$TPM_DIR/bin/clean_plugins" >/dev/null 2>&1 \
        && ok "tmux plugins cleaned" \
        || warn "TPM clean_plugins exited non-zero"
fi

# ── OS package check ────────────────────────────────────────────────────────

# These need a package manager and sudo, so they are out of scope here. Report
# them instead of leaving the user to discover each one via a broken shell.
MISSING_PKGS=()
for cmd in zsh tmux nvim git curl; do
    command_exists "$cmd" || MISSING_PKGS+=("$cmd")
done

# LazyVim compiles treesitter parsers and unzips Mason-installed LSP servers.
for cmd in cc unzip; do
    command_exists "$cmd" || MISSING_PKGS+=("$cmd")
done

if [[ ${#MISSING_PKGS[@]} -gt 0 ]]; then
    warn "Missing OS packages: ${MISSING_PKGS[*]}"
    if command_exists apt-get; then
        warn "Run ./ubuntu-install.sh to install them."
    elif command_exists dnf; then
        warn "Run ./fedora-install.sh to install them."
    fi
fi

ok "Done."
echo ""
echo "  Open a new shell to pick up the changes."
echo "  For a running tmux: <prefix>:source-file ~/.config/tmux/tmux.conf"
